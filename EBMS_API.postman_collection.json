{
  "info": {
    "name": "EBMS API",
    "description": "Enterprise Banking Management System — full API collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" },
    { "key": "token", "value": "" },
    { "key": "accountId", "value": "" },
    { "key": "toAccountId", "value": "" },
    { "key": "userId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth Flow",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Alice Demo\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"Password123\",\n  \"countryCode\": \"US\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('token', data.token);",
                  "pm.collectionVariables.set('userId', data.userId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"Password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('token', data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@ebms.local\",\n  \"password\": \"Admin12345\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('token', data.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Account Operations",
      "item": [
        {
          "name": "Create SAVINGS account",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/accounts/create",
            "body": { "mode": "raw", "raw": "{ \"accountType\": \"SAVINGS\" }" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('accountId', data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create CHECKING account",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/accounts/create",
            "body": { "mode": "raw", "raw": "{ \"accountType\": \"CHECKING\" }" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('toAccountId', data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List my accounts",
          "request": { "method": "GET", "url": "{{baseUrl}}/accounts/my" }
        }
      ]
    },
    {
      "name": "Transaction Operations",
      "item": [
        {
          "name": "Deposit",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/transactions/deposit",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"{{accountId}}\",\n  \"amount\": 1000.00\n}"
            }
          }
        },
        {
          "name": "Withdraw",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/transactions/withdraw",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"{{accountId}}\",\n  \"amount\": 50.00\n}"
            }
          }
        },
        {
          "name": "Transfer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/transactions/transfer",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccountId\": \"{{accountId}}\",\n  \"toAccountId\": \"{{toAccountId}}\",\n  \"amount\": 25.00\n}"
            }
          }
        },
        {
          "name": "History",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/transactions/history?accountId={{accountId}}&page=0&size=20"
          }
        }
      ]
    },
    {
      "name": "Fraud Engine — trigger rules",
      "item": [
        {
          "name": "Trigger CheckLimitRule (huge withdrawal)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/transactions/withdraw",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"{{accountId}}\",\n  \"amount\": 999999.00\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Admin Operations",
      "item": [
        {
          "name": "List users",
          "request": { "method": "GET", "url": "{{baseUrl}}/admin/users" }
        },
        {
          "name": "List accounts",
          "request": { "method": "GET", "url": "{{baseUrl}}/admin/accounts" }
        },
        {
          "name": "Fraud alerts",
          "request": { "method": "GET", "url": "{{baseUrl}}/fraud/alerts" }
        },
        {
          "name": "Fraud audit log",
          "request": { "method": "GET", "url": "{{baseUrl}}/fraud/audit-log" }
        },
        {
          "name": "Reload rules",
          "request": { "method": "POST", "url": "{{baseUrl}}/fraud/rules/reload" }
        },
        {
          "name": "Deactivate user",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/admin/users/{{userId}}/deactivate"
          }
        }
      ]
    }
  ]
}
